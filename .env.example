# Required for application bootstrap and Supabase-backed features
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Optional. The current SkillMatch screen uses heuristic extraction and the
# Supabase catalogue; these are reserved for the optional AI service integration.
AI_BASE_URL=https://your-compatible-chat-endpoint/v1
AI_API_KEY=your-api-key
AI_MODEL=your-model-name
