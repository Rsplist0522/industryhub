# Copy this file to .env before running Flutter.
# Keep .env local. Never put private server-side keys in the Flutter app.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Do not put AI_API_KEY in this file or ship it in the Flutter app.
# Configure the private AI provider as a Supabase Edge Function secret instead:
# npx supabase secrets set AI_API_KEY=YOUR_PRIVATE_AI_KEY
