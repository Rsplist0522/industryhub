# Flutter Web uses these as --dart-define values; this file is documentation only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Do not put AI_API_KEY in this file or ship it in the Flutter app.
# Configure private AI provider values as Supabase Edge Function secrets:
# npx supabase secrets set AI_API_KEY=your-provider-key AI_BASE_URL=https://api.groq.com/openai/v1 AI_MODEL=openai/gpt-oss-20b
