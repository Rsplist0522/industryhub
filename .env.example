# Public client configuration used by the Flutter app
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Do not put AI_API_KEY in this file or ship it in the mobile app.
# Configure the private AI provider values as Supabase Edge Function secrets:
# supabase secrets set AI_API_KEY=... AI_BASE_URL=https://api.openai.com/v1 AI_MODEL=gpt-4o-mini
